# ------------------------------------------------------------------
# Brand Quest environment variables
# Copy this file to `.env.local` and fill in real values.
# ------------------------------------------------------------------

# Where new-member notifications are sent.
# TODO:
# Replace ADMIN_NOTIFICATION_EMAIL with the production email later.
ADMIN_NOTIFICATION_EMAIL=advocatebala.2010@gmail.com

# Where membership contribution notifications are sent.
# Replace with production email later.
NEXT_PUBLIC_MEMBERSHIP_EMAIL=advocatebala.2010@gmail.com

# SMTP credentials for the transactional email service (nodemailer).
# Leave these blank in local development to skip email sending gracefully.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address that outgoing emails are sent "from" (defaults to the recipient).
SMTP_FROM=
# Set to "true" only for implicit TLS (usually port 465).
SMTP_SECURE=false

# ------------------------------------------------------------------
# Admin dashboard credentials and session secret.
# These gate the hidden /admin area. Never hard-code them in source.
# ------------------------------------------------------------------
ADMIN_USER_ID=admin
ADMIN_PASSWORD=admin
# Long random string used to sign the admin session cookie (required in production).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
